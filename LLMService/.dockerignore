# Python virtual environment
.venv/
venv/
env/

# Python cache - keeps host bytecode out of the image
__pycache__/
*.py[cod]

# Git and IDE
.git/
.gitignore
.idea/

# Testing and tooling
.pytest_cache/
.mypy_cache/

# OS files
.DS_Store
Thumbs.db

# Fine-tuning checkpoints - only the adapter at the root of
# app/LocalLLM/qwen-query-generator is loaded at runtime
app/LocalLLM/**/checkpoint-*/
