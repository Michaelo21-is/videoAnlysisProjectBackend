// Discover Docker containers.
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

// Define rules applied by loki.source.docker.
discovery.relabel "containers" {
  targets = []

  // Collect only application microservices.
  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_compose_service",
    ]

    regex = "auth-service|notification-service|api-gateway|user-service|purchase-service"
    action = "keep"
  }

  // Remove the leading slash from the container name.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // Compose service name.
  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_compose_service",
    ]

    target_label = "service_name"
  }

  // Compose project name.
  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_compose_project",
    ]

    target_label = "compose_project"
  }

  // stdout or stderr.
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "containers" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.docker.containers.targets

  relabel_rules = discovery.relabel.containers.rules

  labels = {
    job         = "docker",
    environment = "development",
  }

  forward_to = [loki.process.redact.receiver]
}

loki.process "redact" {
  // Bearer token.
  stage.replace {
    expression = "(?i)bearer\\s+([A-Za-z0-9._\\-]+)"
    replace    = "***REDACTED***"
  }

  // Raw JWT.
  stage.replace {
    expression = "(eyJ[A-Za-z0-9_\\-]+\\.[A-Za-z0-9_\\-]+\\.[A-Za-z0-9_\\-]+)"
    replace    = "***REDACTED_JWT***"
  }

  // Cookie and Set-Cookie values.
  stage.replace {
    expression = "(?i)(?:set-)?cookie:\\s*([^\\r\\n]+)"
    replace    = "***REDACTED***"
  }

  // CSRF and XSRF values.
  stage.replace {
    expression = "(?i)x?[-_]?csrf[-_]?token\"?\\s*[:=]\\s*\"?([^\"\\s,&}]+)"
    replace    = "***REDACTED***"
  }

  // Password values.
  stage.replace {
    expression = "(?i)pass(?:word)?\"?\\s*[:=]\\s*\"?([^\"\\s,&}]+)"
    replace    = "***REDACTED***"
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}